/// Turns `integrations/Integrations.pkl` and its assets into a complete
/// file plan. The driver supplies each sealed digest as the property
/// `sha256.<path>`. Without it, a seal renders as 64 zeros.
module Project

import "../../integrations/Integrations.pkl"

/// One projected file at a repository-relative path.
class File {
  path: String(matches(Regex(#"(marketplace|commands)/[A-Za-z0-9._/-]+"#)))
  text: String
  /// Paths whose digests this file embeds.
  seals: Listing<String>(isDistinct)
}

local json = new JsonRenderer {}
local sealToken = Regex(#"@@sha256:([A-Za-z0-9._/-]+)@@"#)
local zeroDigest = "0".repeat(64)
local assetRoot = "../../integrations/assets/"

local function document(target: String, value: Dynamic): File = new {
  path = target
  text = json.renderDocument(value)
  seals {}
}

local function asset(target: String, source: String): File = new {
  path = target
  text = source.replaceAllMapped(sealToken, (match) ->
    read?("prop:sha256.\(match.groups[1].value)") ?? zeroDigest
  )
  seals {
    for (reference in sealToken.findMatchesIn(source).map((match) -> match.groups[1].value).distinct) {
      reference
    }
  }
}

files: Listing<File>(isDistinctBy((it) -> it.path)) = new {
  for (harness in Integrations.harnesses) {
    document("marketplace/harness/\(harness.id)/\(harness.fileName)", harness.document)
  }
  for (manifest in List(".claude-plugin", ".factory-plugin")) {
    document("marketplace/git-attributed/\(manifest)/plugin.json", Integrations.plugin.document)
  }
  new File {
    path = "marketplace/git-attributed/LICENSE"
    text = read("../../LICENSE.upstream").text
    seals {}
  }
  for (assetPath in Integrations.assets) {
    asset(assetPath, read("\(assetRoot)\(assetPath)").text)
  }
}

/// One file of a provider branch tree, at a path relative to that tree.
class ProviderFile {
  path: String(matches(Regex(#"[A-Za-z0-9_.][A-Za-z0-9._-]*(/[A-Za-z0-9_.][A-Za-z0-9._-]*)*"#)))
  text: String
}

local byPath: Map<String, File> = files.toList().toMap((it) -> it.path, (it) -> it)
local plugin = Integrations.plugin
local market = Integrations.marketplace
local pluginRoot = "marketplace/git-attributed"
local bundled = List("README.md", "LICENSE", "commands/git-attributed-setup.md", "skills/git-attributed/SKILL.md")

/// A provider file whose bytes are the projected repository file at source.
local function copied(target: String, source: String): ProviderFile = new {
  path = target
  text = byPath[source].text
}

local function rendered(target: String, value: Dynamic): ProviderFile = new {
  path = target
  text = json.renderDocument(value)
}

/// The plugin directory that a Claude Code or Factory marketplace lists.
local function bundle(manifestDirectory: String): Listing<ProviderFile> = new {
  copied("plugins/\(plugin.name)/\(manifestDirectory)/plugin.json", "\(pluginRoot)/\(manifestDirectory)/plugin.json")
  for (name in bundled) {
    copied("plugins/\(plugin.name)/\(name)", "\(pluginRoot)/\(name)")
  }
}

/// The tree published to each `harness/<provider>` branch.
providers: Mapping<"claude"|"factory"|"gemini", Listing<ProviderFile>(isDistinctBy((it) -> it.path))> = new {
  ["claude"] = (bundle(".claude-plugin")) {
    rendered(".claude-plugin/marketplace.json", new Dynamic {
      name = market.name
      description = market.description
      owner { name = market.owner }
      plugins {
        new {
          name = plugin.name
          source = "./plugins/\(plugin.name)"
          description = plugin.description
          category = market.category
          homepage = plugin.homepage
          keywords = plugin.keywords
        }
      }
    })
  }
  ["factory"] = (bundle(".factory-plugin")) {
    rendered(".factory-plugin/marketplace.json", new Dynamic {
      name = market.name
      description = market.description
      owner { name = market.owner }
      plugins {
        new {
          name = plugin.name
          description = plugin.description
          source = "./plugins/\(plugin.name)"
          category = market.category
          homepage = plugin.homepage
          tags = plugin.keywords
        }
      }
    })
  }
  ["gemini"] = new {
    rendered("gemini-extension.json", new Dynamic {
      name = plugin.name
      version = plugin.version
      description = plugin.description
    })
    copied("commands/git-attributed-setup.toml", "commands/git-attributed-setup.toml")
    copied("LICENSE", "\(pluginRoot)/LICENSE")
  }
}

output {
  renderer = new JsonRenderer {}
  value = new Dynamic {
    files = module.files
    providers = module.providers
  }
}
